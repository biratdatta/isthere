---
import '@fontsource/bricolage-grotesque/600.css';
import '@fontsource/bricolage-grotesque/700.css';
import '@fontsource/bricolage-grotesque/800.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@fontsource/geist-mono/700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Rail from '../components/Rail.astro';
import { OG_VERSION, SITE_NAME, abs, graph, ldJson, organization, website } from '../lib/seo';
import type { Kind } from '../lib/kinds';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  jsonld?: object[];
  kind?: Kind;
  current?: 'list' | 'submit' | 'advertise';
  home?: boolean;
  noindex?: boolean;
}

const { title, description, path, ogImage = '/og/index.png', jsonld = [], kind, current, home = false, noindex = false } = Astro.props;
const site = Astro.site!;
const canonical = abs(site, path);
const og = `${abs(site, ogImage)}?v=${OG_VERSION}`;
const ld = graph(website(site), organization(site), ...jsonld);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={kind ? `/favicon-${kind}.svg` : '/favicon.svg'} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14171d" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
        } catch (e) {}
        // Safety net: if the main script never runs, show the real numbers anyway.
        setTimeout(function () {
          document.querySelectorAll('[data-odometer]').forEach(function (el) { el.setAttribute('data-rolled', '1'); });
        }, 5000);
      })();
    </script>
    <script type="application/ld+json" set:html={ldJson(ld)} />
  </head>
  <body>
    <a class="sr-only" href="#main">Skip to content</a>
    <Header kind={kind} current={current} />
    <div class="shell">
      <Rail side="left" />
      <main id="main" class={`content${home ? ' home' : ''}`}>
        <slot />
        <Footer />
      </main>
      <Rail side="right" />
    </div>
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CATEGORIES, apps, formatPrice, freeAlternatives } from '../lib/apps';
import { breadcrumbs } from '../lib/seo';

const site = Astro.site!;
const rows = apps()
  .map((a) => ({ ...a, alts: freeAlternatives(a.slug), price: a.entries.find((e) => e.priceMonthly !== null)?.priceMonthly ?? null }))
  .filter((a) => a.alts.length > 0);
const total = rows.reduce((n, r) => n + r.alts.length, 0);
---
<Base title={`Free, open-source alternatives to ${rows.length} paid SaaS apps`} description={`${total} free, open-source alternatives you can self-host instead of paying for ${rows.length} SaaS apps.`} path="/alternatives"
  jsonld={[breadcrumbs(site, [{ name: 'Home', path: '/' }, { name: 'Free alternatives', path: '/alternatives' }])]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Free alternatives</li></ol></nav>
  <section class="page-title">
    <h1>Don’t want to build it? <span class="hl">Use the free one.</span></h1>
    <p class="muted" style="font-size:18px;max-width:640px">{total} open-source alternatives to {rows.length} paid apps. All $0 to self-host. No votes, no pay-to-list.</p>
  </section>
  <section class="stack" style="gap:14px">
    {rows.map((r) => (
      <div class="card pad alt-group" id={r.slug}>
        <div class="alt-head">
          <span class="letter"><img src={`/api/favicon/${r.slug}`} width="24" height="24" alt="" loading="lazy" /></span>
          <span style="flex:1;min-width:0"><strong>{r.name}</strong><span class="muted" style="font-size:13px;display:block">{CATEGORIES[r.category].label}{r.price !== null && ` · ${formatPrice(r.price)}/mo`}</span></span>
          <a class="more-link" href={`/compare/${r.slug}`}>Compare answers <Icon name="arrow" size={14} /></a>
        </div>
        <ul class="prior alts">
          {r.alts.map((p) => <li><a href={p.url} rel="noopener"><span>{p.name}<small>{p.desc ?? p.url.replace(/^https?:\/\//, '')}</small></span><span class="free">$0 · FREE</span><Icon name="external" size={16} /></a></li>)}
        </ul>
      </div>
    ))}
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import PromptBlock from '../components/PromptBlock.astro';
import rebuildPrompt from '../../data/rebuild-prompt.md?raw';
import { REPO_URL, breadcrumbs } from '../lib/seo';

const site = Astro.site!;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Rebuild prompt', path: '/rebuild' },
];
---
<Base
  title="Can this site be rebuilt with one prompt? Yes. Here it is."
  description="The exact one-shot prompt used to build Is there a skill for it?, with copy buttons for Claude Code, Codex and Cursor. The site practices what it preaches."
  path="/rebuild"
  ogImage="/og/rebuild.png"
  jsonld={[breadcrumbs(site, crumbs)]}
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol><li><a href="/">Home</a></li><li><span aria-current="page">Rebuild prompt</span></li></ol>
    </nav>
    <section class="hero" style="padding-top:32px">
      <span class="eyebrow">practice what you preach</span>
      <h1>Can this site be rebuilt with one prompt<span class="q">?</span></h1>
      <div class="prose">
        <p><strong>Yes.</strong> Everything you see, from the Death List to the odometer and the OG images, came from the prompt below. Paste it into your agent of choice and you get your own copy.</p>
        <p>Since then it has grown into four directories (skills, MCPs, plugins and prompts), but the core came from this one prompt. The data in <code>data/*/*.json</code> is the part that took judgment. The <a href={REPO_URL} rel="noopener">source is MIT-licensed on GitHub</a>.</p>
      </div>
    </section>
    <section style="padding-top:0">
      <PromptBlock prompt={rebuildPrompt.trim()} filename="isthere.prompt.md" />
    </section>
  </div>
</Base>

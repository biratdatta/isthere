---
import Base from '../../layouts/Base.astro';
import EntryCards from '../../components/EntryCards.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORIES, ENTRIES, apps } from '../../lib/apps';
import { KINDS, KIND_ORDER } from '../../lib/kinds';
import { breadcrumbs, entryPath, entryTitle, itemList } from '../../lib/seo';

export function getStaticPaths() {
  return Object.keys(CATEGORIES)
    .filter((cat) => ENTRIES.some((e) => e.category === cat))
    .map((cat) => ({ params: { cat } }));
}
const { cat } = Astro.params as { cat: string };
const c = CATEGORIES[cat];
const site = Astro.site!;
const entries = ENTRIES.filter((e) => e.category === cat);
const appRows = apps().filter((a) => a.category === cat);
const title = `Is there an AI replacement for ${c.label.toLowerCase()} tools? ${appRows.length} apps checked`;
const description = `${appRows.length} paid ${c.label.toLowerCase()} apps checked for a skill, MCP server, plugin, prompt or AI agent that replaces them.`;
---
<Base title={title} description={description} path={`/category/${cat}`}
  jsonld={[breadcrumbs(site, [{ name: 'Home', path: '/' }, { name: c.label, path: `/category/${cat}` }]), itemList(site, c.label, entries.map((e) => ({ name: entryTitle(e), path: entryPath(e) })))]}>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">{c.label}</li></ol></nav>
  <section class="page-title">
    <h1>{c.emoji} <span class="hl">{c.label}</span>, replaced?</h1>
    <p class="muted" style="font-size:18px;max-width:640px">{appRows.length} paid {c.label.toLowerCase()} apps, checked across every directory.</p>
  </section>
  <section class="card pad" style="overflow-x:auto">
    <table class="cmp-table">
      <thead><tr><th>App</th>{KIND_ORDER.map((k) => <th class={`k-${k}`}><Icon name={k} size={14} /> {KINDS[k].plural}</th>)}</tr></thead>
      <tbody>
        {appRows.map((a) => (
          <tr>
            <th><a href={`/compare/${a.slug}`}>{a.name}</a></th>
            {KIND_ORDER.map((k) => {
              const e = a.entries.find((x) => x.kind === k);
              return <td>{e ? <a href={entryPath(e)} class={`pill v-${e.verdict}`}>{KINDS[k].verdicts[e.verdict].label}</a> : <span class="muted">—</span>}</td>;
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </section>
  <section class="stack" style="gap:16px">
    <span class="eyebrow">All {entries.length} answers</span>
    <EntryCards entries={entries} />
  </section>
  <section class="chips-row">
    {Object.entries(CATEGORIES).filter(([k]) => k !== cat && ENTRIES.some((e) => e.category === k)).map(([k, x]) => <a class="chip" href={`/category/${k}`}>{x.emoji} {x.label}</a>)}
  </section>
</Base>

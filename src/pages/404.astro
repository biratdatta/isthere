---
import Base from '../layouts/Base.astro';
---
<Base title="Is there a page for it? No. (404)" description="This page does not exist." path="/404" noindex>
  <div class="wrap">
    <section class="hero">
      <span class="eyebrow">error 404</span>
      <h1>Is there a page for it<span class="q">?</span></h1>
      <div class="verdict no" style="max-width:640px">
        <div class="label">THE VERDICT</div>
        <div class="big">NOT REALLY</div>
        <p class="headline">Nothing lives at <code data-404-path>this address</code>.</p>
        <p>Maybe nobody has added that app yet. <a href="/">Back to the directories →</a></p>
      </div>
    </section>
  </div>
  <script is:inline>
    (function () { var c = document.querySelector('[data-404-path]'); if (c) c.textContent = location.pathname; })();
  </script>
</Base>

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Odometer from '../../components/Odometer.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import InstallBlock from '../../components/InstallBlock.astro';
import SuggestAlt from '../../components/SuggestAlt.astro';
import { CATEGORIES, ENTRIES, addedOn, contributorOf, formatPrice, freeAlternatives, keyOf, lastPriceChange, relatedEntries, siblings, verdictLabel, type Entry } from '../../lib/apps';
import { KINDS } from '../../lib/kinds';
import { mcpInstalls, pluginInstalls, skillInstalls } from '../../lib/installs';
import { breadcrumbs, entryDescription, entryPath, entryTitle, faqFor, faqPage, shortUrl } from '../../lib/seo';

export function getStaticPaths() {
  return ENTRIES.map((e) => ({ params: { kind: e.kind, slug: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Entry };
const site = Astro.site!;
const k = KINDS[e.kind];
const c = CATEGORIES[e.category];
const v = k.verdicts[e.verdict];
const key = keyOf(e);
const related = relatedEntries(e);
const also = siblings(e);
const faq = faqFor(e);
const short = shortUrl(e);
const shareText =
  k.metric === 'mrr' && e.priceMonthly
    ? `I just replaced ${e.name} (${formatPrice(e.priceMonthly)}/mo) with ${k.article} ${k.word}. Verdict: ${v.label}.`
    : `${entryTitle(e)} Verdict: ${v.label}.`;
const shareUrl = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(short)}`;
const alts = freeAlternatives(e.slug);
const change = lastPriceChange(e);
const who = contributorOf(e);
const fmtDate = (d: string) => new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const badgeUrl = new URL(`/badge/${e.kind}/${e.slug}.svg`, site).href;
const pageUrl = new URL(entryPath(e), site).href;
const badgeMd = `[![${entryTitle(e)} ${v.label}](${badgeUrl})](${pageUrl})`;
const badgeHtml = `<a href="${pageUrl}"><img src="${badgeUrl}" alt="${entryTitle(e)} ${v.label}" height="20"></a>`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: k.plural, path: `/${e.kind}` },
  { name: e.name, path: entryPath(e) },
];
const installs = e.kind === 'mcp' ? mcpInstalls(e) : e.kind === 'skills' ? skillInstalls(e) : e.kind === 'plugins' ? pluginInstalls(e) : [];
const goodsTitle = {
  prompts: `Build your own ${e.name}`,
  skills: `Install the ${e.kind === 'skills' ? e.skill.name : ''} skill`,
  mcp: `Connect ${e.name} to your agent`,
  plugins: `Install the ${e.kind === 'plugins' ? e.plugin.name : ''} plugin`,
  agents: `Hire ${e.kind === 'agents' ? e.agent.name : 'the agent'}`,
}[e.kind];
const titleParts = k.entryTitle(e.name).split(k.word);
const isMrr = k.metric === 'mrr';
const price = e.priceMonthly;
---
<Base title={entryTitle(e)} description={entryDescription(e)} path={entryPath(e)} ogImage={`/og/${e.kind}/${e.slug}.png`} kind={e.kind} jsonld={[breadcrumbs(site, crumbs), faqPage(faq)]}>
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href={`/${e.kind}`}>{k.plural}</a></li>
      <li><a href={`/category/${e.category}`}>{c.label}</a></li>
      <li aria-current="page">{e.name}</li>
    </ol>
  </nav>

  <section class={`split k-${e.kind} v-${e.verdict}`} style="align-items:stretch">
    <div class="card title-card">
      <span style="display:flex;align-items:center;gap:14px">
        <span class="letter lg"><img src={`/api/favicon/${e.slug}`} width="32" height="32" alt={`${e.name} logo`} /></span>
        <span class="title-meta">
          <span>{c.label}</span>
          {price !== null && <><span>·</span><span>from {formatPrice(price)}/mo</span></>}
          <span>·</span><a href={`https://${e.domain}`} rel="noopener nofollow">{e.domain}</a>
        </span>
      </span>
      <h1>{titleParts.length === 2 ? <>{titleParts[0]}<span class="hl">{k.word}</span>{titleParts[1]}</> : entryTitle(e)}</h1>
      <ul class="stat-row" aria-label="At a glance">
        {isMrr && price !== null && price > 0 && <li><span>you’d save</span><b class="save">{formatPrice(price * 12)}/yr</b></li>}
        <li><span>{k.voted}</span><b><span data-count-key={key}>0</span> people</b></li>
        <li><span>viewed</span><b><span data-live="views">0</span> times</b></li>
        <li><span>added</span><b>{fmtDate(addedOn(e))}</b></li>
        {e.checked && <li><span>price checked</span><b>{fmtDate(e.checked)}</b></li>}
      </ul>
      {also.length > 0 && (
        <div class="also">
          <span>Also for {e.name}:</span>
          {also.map((s) => (
            <a href={entryPath(s)} class={`k-${s.kind} v-${s.verdict}`}><Icon name={s.kind} size={15} />{KINDS[s.kind].article} {KINDS[s.kind].word}<span class="vv">{verdictLabel(s)}</span></a>
          ))}
        </div>
      )}
    </div>
    <div class="verdict-card">
      <span class="eyebrow">The verdict</span>
      <span class="big">{v.label === 'NOT REALLY' ? 'Not really' : v.label.charAt(0) + v.label.slice(1).toLowerCase()}</span>
      <span style="display:flex;flex-direction:column;gap:6px"><strong>{v.headline}</strong><span class="muted" style="font-size:14px;line-height:1.5">{v.blurb}</span></span>
      <form class="agree" method="post" action={`/api/verdict/${e.kind}/${e.slug}`} data-verdict={key}>
        <span class="q">Agree with this verdict?</span>
        <span class="agree-btns">
          <button type="submit" name="agree" value="1" class="btn btn-sm"><Icon name="check" size={14} />Agree</button>
          <button type="submit" name="agree" value="0" class="btn btn-sm"><Icon name="x" size={14} />Disagree</button>
        </span>
        <span class="agree-bar" aria-hidden="true"><i data-agree-bar style="width:0%"></i></span>
        <span class="agree-note" data-agree-note>Be the first to weigh in.</span>
      </form>
    </div>
  </section>

  <section class={`split k-${e.kind}`}>
    <div class="stack">
      <div id="goods" class="card pad stack" style="gap:18px">
        <span style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px">
          <h2 class="section-title">{goodsTitle}</h2>
          {e.kind === 'mcp' && (
            <span class="facts">
              <span>{e.server.official ? 'official' : 'community'}</span>
              <span>{e.server.transport === 'http' ? 'remote · HTTP' : 'local · stdio'}</span>
              <span>auth: {e.server.auth}</span>
              {(e.server.docsUrl ?? e.server.repoUrl) && <a href={e.server.docsUrl ?? e.server.repoUrl} rel="noopener">{e.server.docsUrl ? 'docs' : 'repo'} ↗</a>}
            </span>
          )}
          {e.kind === 'skills' && e.skill.sourceUrl && <span class="facts"><a href={e.skill.sourceUrl} rel="noopener">source ↗</a></span>}
          {e.kind === 'plugins' && <span class="facts"><a href={e.plugin.repoUrl} rel="noopener">{e.plugin.marketplace} ↗</a></span>}
          {e.kind === 'agents' && (
            <span class="facts">
              <span>by {e.agent.maker}</span>
              <span>{e.agent.autonomy === 'autonomous' ? 'works on its own' : 'you review its work'}</span>
              {e.agent.openSource && e.agent.repoUrl && <a href={e.agent.repoUrl} rel="noopener">open source ↗</a>}
            </span>
          )}
        </span>

        {e.kind === 'prompts' && <PromptBlock prompt={e.prompt} filename={`${e.slug}.prompt.md`} />}
        {e.kind !== 'prompts' && e.kind !== 'agents' && <InstallBlock options={installs} />}
        {e.kind === 'agents' && (
          <div class="agent-card">
            <span class="letter lg agent-ico"><Icon name="agents" size={26} /></span>
            <span class="agent-meta">
              <strong>{e.agent.name}</strong>
              <span class="muted">{e.agent.price}</span>
            </span>
            <span class="agent-cta">
              {e.agent.pricingUrl && <a class="btn" href={e.agent.pricingUrl} rel="noopener nofollow">Pricing ↗</a>}
              <a class="btn btn-ink" href={e.agent.url} rel="noopener nofollow">Try {e.agent.name} <Icon name="external" size={14} /></a>
            </span>
          </div>
        )}
        {e.kind === 'agents' && (
          <div class="stack" style="gap:10px">
            <strong>What it does</strong>
            <div class="tool-chips">{e.agent.does.map((t) => <span>{t}</span>)}</div>
          </div>
        )}

        {e.kind === 'skills' && e.skill.skillMd && (
          <details class="faq" style="margin-top:4px">
            <summary>Read the SKILL.md (written for this site, MIT)</summary>
            <div class="code" style="margin-top:12px">
              <div class="code-bar"><span>{e.skill.name}/SKILL.md</span><button class="btn-copy" type="button" data-copy-code><Icon name="copy" size={13} /><span class="idle">Copy</span><span class="ok">Copied</span></button></div>
              <pre tabindex="0"><code data-code>{e.skill.skillMd}</code></pre>
            </div>
          </details>
        )}

        {e.kind === 'mcp' && e.tools.length > 0 && (
          <div class="stack" style="gap:10px">
            <strong>Tools it exposes</strong>
            <div class="tool-chips">{e.tools.map((t) => (/^[a-z_-]+$/.test(t) ? <code>{t}</code> : <span>{t}</span>))}</div>
          </div>
        )}
        {e.kind === 'plugins' && (
          <div class="stack" style="gap:10px">
            <strong>What’s inside</strong>
            <div class="tool-chips">{e.plugin.includes.map((t) => <span>{t}</span>)}</div>
          </div>
        )}
      </div>

      <div class="card pad stack">
        <h2 class="section-title">{e.kind === 'mcp' ? 'Limitations' : 'What you lose'}</h2>
        <ul class="lose">
          {e.whatYouLose.map((item) => <li><span class="x"><Icon name="x" size={12} /></span>{item}</li>)}
        </ul>
        <p class="notes">{e.notes}</p>
        <p class="credit">Added by <a href={who.url ?? '/contributors'} rel="noopener">@{who.name}</a> · <a href="/contributors">contributors</a></p>
      </div>

      <div class="card pad stack" id="alternatives">
        <span style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px">
          <h2 class="section-title">Free alternatives</h2>
          <span class="muted" style="font-size:13px">Open source, $0 to self-host</span>
        </span>
        {alts.length > 0 ? (
          <ul class="prior alts">
            {alts.map((p) => (
              <li><a href={p.url} rel="noopener"><span>{p.name}<small>{p.desc ?? p.url.replace(/^https?:\/\//, '')}</small></span><span class="free">$0 · FREE</span><Icon name="external" size={16} /></a></li>
            ))}
          </ul>
        ) : (
          <p class="muted" style="margin:0">None listed yet. Know a free one?</p>
        )}
        {alts.length > 0 && <a class="more-link" href={`/alternatives#${e.slug}`}>All free alternatives to {e.name} <Icon name="arrow" size={14} /></a>}
        <SuggestAlt app={e.name} />
      </div>

      <a class={`card compare-cta`} href={`/compare/${e.slug}`}>
        <span><span class="eyebrow">Compare</span><strong>Every answer for {e.name}, side by side</strong></span>
        <span class="mini-verdicts">{siblings(e).concat([e]).map((x) => <span class={`k-${x.kind}`} title={`${KINDS[x.kind].plural}: ${verdictLabel(x)}`}><Icon name={x.kind} size={14} /></span>)}</span>
        <Icon name="arrow" size={18} />
      </a>

      <div class="card pad faq">
        <h2 class="section-title" style="margin-bottom:10px">{e.name}, answered</h2>
        {faq.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>

    <aside class="stack sticky" aria-label="Price, vote and share">
      <div class="card pad stack" style="gap:10px;padding:22px">
        <span class="eyebrow">{isMrr ? 'Monthly cost' : `${e.name} costs`}</span>
        {price === null ? (
          <span class="price" style="font-size:24px">usage-based</span>
        ) : isMrr ? (
          <span class="price"><s>{formatPrice(price)}</s> <small>→</small> <span class="zero">$0</span></span>
        ) : (
          <span class="price">{formatPrice(price)}<small>/mo</small></span>
        )}
        <span class="muted" style="font-size:13px">
          {e.priceNote ?? (price !== null ? `${formatPrice(price * 12)}/yr per seat.` : '')}
          {e.pricingUrl && <> · <a href={e.pricingUrl} rel="noopener nofollow" style="text-decoration:underline">Pricing ↗</a></>}
        </span>
        {change && (
          <span class={`price-change ${change.to !== null && change.from !== null && change.to > change.from ? 'up' : 'down'}`}>
            {change.from !== null && change.to !== null ? (change.to > change.from ? 'Price went up' : 'Price went down') : 'Price changed'}: {formatPrice(change.from)} → {formatPrice(change.to)} · {fmtDate(change.date)}
          </span>
        )}
        {isMrr && price !== null && price > 0 && (
          <div class="calc" data-calc={price}>
            <label for="calc-seats">Seats</label>
            <input id="calc-seats" type="number" min="1" max="10000" value="1" inputmode="numeric" data-calc-seats />
            <span>you’d save <b data-calc-out>{formatPrice(price * 12)}</b>/yr</span>
          </div>
        )}
      </div>
      <div class="card stack" style="gap:12px;padding:22px;position:relative">
        <span class="eyebrow">{isMrr ? 'Did you do it?' : 'Using it?'}</span>
        <form method="post" action={`/api/vote/${e.kind}/${e.slug}`} data-vote={key} data-price={isMrr ? price ?? 0 : 0}>
          <button class="vote-btn" type="submit">
            <span style="display:inline-flex;align-items:center;gap:8px"><Icon name={e.kind} size={18} /> {k.vote}</span>
            <Odometer value={0} label={`0 people ${k.voted}`} countKey={key} />
          </button>
        </form>
        <p class="vote-note" role="status" aria-live="polite" data-vote-note>One vote per person per day. No account needed.</p>
        <div class="two">
          <a class="btn" href={shareUrl} target="_blank" rel="noopener"><Icon name="share" size={15} />Share on X</a>
          <button class="btn" type="button" data-copy-text={short}><Icon name="link" size={15} /><span class="idle">Copy link</span><span class="ok">Copied</span></button>
        </div>
        <p class="share-preview">“{shareText}” <span>{short.replace('https://', '')}</span></p>
        <button class="btn stack-btn" type="button" data-stack-add={key} data-stack-name={e.name}><Icon name="plus" size={15} /><span class="idle">Add to my stack</span><span class="ok">In your stack</span></button>
      </div>
      <details class="card embed">
        <summary><span class="eyebrow">Embed badge</span><img src={`/badge/${e.kind}/${e.slug}.svg`} alt="" height="20" loading="lazy" /></summary>
        <div class="stack" style="gap:8px;margin-top:12px">
          <span class="muted" style="font-size:13px">For a README or docs page. Links back here.</span>
          <button class="btn btn-sm" type="button" data-copy-text={badgeMd}><Icon name="copy" size={14} /><span class="idle">Copy Markdown</span><span class="ok">Copied</span></button>
          <button class="btn btn-sm" type="button" data-copy-text={badgeHtml}><Icon name="copy" size={14} /><span class="idle">Copy HTML</span><span class="ok">Copied</span></button>
        </div>
      </details>
      {related.length > 0 && (
        <div class="card stack" style="gap:4px;padding:14px">
          <span class="eyebrow" style="padding:8px 8px 4px">More {k.plural}</span>
          {related.map((r) => (
            <a href={entryPath(r)} class={`mini-row v-${r.verdict}`}>
              <span class="letter sm"><img src={`/api/favicon/${r.slug}`} width="20" height="20" alt="" loading="lazy" /></span>
              <span style="min-width:0"><strong>{r.name}</strong><span class="m">{CATEGORIES[r.category].label}{r.priceMonthly !== null && ` · ${formatPrice(r.priceMonthly)}/mo`} · <span data-count-key={keyOf(r)}>0</span> {k.voted}</span></span>
              <span class="badge" style="font-size:9px;padding:5px 8px">{verdictLabel(r)}</span>
            </a>
          ))}
        </div>
      )}
    </aside>
  </section>
</Base>

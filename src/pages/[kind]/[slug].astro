---
import Base from '../../layouts/Base.astro';
import Odometer from '../../components/Odometer.astro';
import Waitlist from '../../components/Waitlist.astro';
import PromptBlock from '../../components/PromptBlock.astro';
import InstallBlock from '../../components/InstallBlock.astro';
import { CATEGORIES, ENTRIES, formatPrice, keyOf, relatedEntries, siblings, verdictLabel, type Entry } from '../../lib/apps';
import { KINDS } from '../../lib/kinds';
import { mcpInstalls, pluginInstalls, skillInstalls } from '../../lib/installs';
import { abs, breadcrumbs, entryDescription, entryPath, entryTitle, faqFor, faqPage } from '../../lib/seo';

export function getStaticPaths() {
  return ENTRIES.map((e) => ({ params: { kind: e.kind, slug: e.slug }, props: { e } }));
}

const { e } = Astro.props as { e: Entry };
const site = Astro.site!;
const k = KINDS[e.kind];
const c = CATEGORIES[e.category];
const v = k.verdicts[e.verdict];
const key = keyOf(e);
const related = relatedEntries(e);
const also = siblings(e);
const faq = faqFor(e);
const canonical = abs(site, entryPath(e));

const shareText = `${entryTitle(e)} Verdict: ${v.label}.`;
const shareUrl = `https://x.com/intent/post?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(canonical)}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: k.plural, path: `/${e.kind}` },
  { name: e.name, path: entryPath(e) },
];
const installs = e.kind === 'mcp' ? mcpInstalls(e) : e.kind === 'skills' ? skillInstalls(e) : e.kind === 'plugins' ? pluginInstalls(e) : [];
const goodsTitle = { prompts: `Build your own ${e.name}`, skills: `Install the ${e.kind === 'skills' ? e.skill.name : ''} skill`, mcp: `Connect ${e.name} to your agent`, plugins: `Install the ${e.kind === 'plugins' ? e.plugin.name : ''} plugin` }[e.kind];
const goodsEyebrow = { prompts: 'the one-shot prompt', skills: 'the skill', mcp: 'the server', plugins: 'the plugin' }[e.kind];
const loseTitle = e.kind === 'mcp' ? 'Limitations' : 'What you lose';
const voteNote = 'One vote per person per day. No account needed.';
---
<Base title={entryTitle(e)} description={entryDescription(e)} path={entryPath(e)} ogImage={`/og/${e.kind}/${e.slug}.png`} kind={e.kind} jsonld={[breadcrumbs(site, crumbs), faqPage(faq)]}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href={`/${e.kind}`}>{k.emoji} {k.plural}</a></li>
        <li><a href={`/${e.kind}?cat=${e.category}#list`}>{c.label}</a></li>
        <li><span aria-current="page">{e.name}</span></li>
      </ol>
    </nav>

    <div class="app-hero">
      <div>
        <img class="fav-lg" src={`/api/favicon/${e.slug}`} width="56" height="56" alt={`${e.name} logo`} />
        <h1>{entryTitle(e)}</h1>
        <div class="meta">
          <span>{c.emoji} {c.label}</span>
          {e.priceMonthly !== null && <span>from <b>{formatPrice(e.priceMonthly)}</b>/mo</span>}
          <a href={`https://${e.domain}`} rel="noopener nofollow">{e.domain} ↗</a>
        </div>

        <div class={`verdict ${e.verdict}`}>
          <div class="label">THE VERDICT</div>
          <div class="big">{v.label}</div>
          <p class="headline">{v.headline}</p>
          <p>{v.blurb}</p>
        </div>

        {also.length > 0 && (
          <div class="also">
            <span class="muted">Also for {e.name}:</span>
            {also.map((s) => (
              <a class="chip" href={entryPath(s)}>
                {KINDS[s.kind].emoji} {KINDS[s.kind].article} {KINDS[s.kind].word} <span class={`badge ${s.verdict}`}>{verdictLabel(s)}</span>
              </a>
            ))}
          </div>
        )}
      </div>

      <aside class="side" aria-label="Vote and share">
        <div class="panel">
          <h3>{k.metric === 'mrr' ? 'Monthly cost' : `${e.name} costs`}</h3>
          {k.metric === 'mrr' && e.priceMonthly !== null ? (
            <div class="price-big"><s>{formatPrice(e.priceMonthly)}</s><span class="arrow">→</span><span class="zero">$0</span></div>
          ) : (
            <div class="price-big">{e.priceMonthly === null ? <span style="font-size:22px">usage-based</span> : <>{formatPrice(e.priceMonthly)}<span class="arrow">/mo</span></>}</div>
          )}
          <p class="muted" style="font-size:12px;margin:8px 0 0">
            {e.priceNote ?? (e.priceMonthly !== null ? `${formatPrice(e.priceMonthly * 12)}/yr per seat.` : '')}
            {e.pricingUrl && <> <a href={e.pricingUrl} rel="noopener nofollow">Pricing ↗</a></>}
          </p>
        </div>
        <div class="panel" style="position:relative">
          <h3>{k.metric === 'mrr' ? 'Did you do it?' : 'Using it?'}</h3>
          <form method="post" action={`/api/vote/${e.kind}/${e.slug}`} data-vote={key} data-price={k.metric === 'mrr' ? e.priceMonthly ?? 0 : 0}>
            <button class="btn btn-primary vote-btn" type="submit">
              <span>{k.metric === 'mrr' ? '🪦' : '🔌'} {k.vote}</span>
              <Odometer value={0} label={`0 people ${k.voted}`} countKey={key} />
            </button>
          </form>
          <p class="vote-note" role="status" aria-live="polite" data-vote-note>{voteNote}</p>
          <div class="share-row">
            <a class="btn" href={shareUrl} target="_blank" rel="noopener">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23 22h-6.2l-4.8-6.3L6.4 22H3.3l7.3-8.3L1 2h6.3l4.4 5.8L18.9 2Zm-1.1 18h1.7L6.3 3.9H4.5L17.8 20Z"/></svg>
              Share on X
            </a>
            <button class="btn" type="button" data-copy-text={canonical}><span class="idle">Copy link</span><span class="ok">✓ Copied</span></button>
          </div>
        </div>
      </aside>
    </div>

    <section id="goods" aria-labelledby="goods-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">{goodsEyebrow}</span>
          <h2 id="goods-title">{goodsTitle}</h2>
        </div>
        {e.kind === 'mcp' && (
          <div class="facts">
            <span class={`badge ${e.server.official ? 'yes' : 'kinda'}`}>{e.server.official ? 'OFFICIAL' : 'COMMUNITY'}</span>
            <span class="fact">{e.server.transport === 'http' ? 'remote · HTTP' : 'local · stdio'}</span>
            <span class="fact">auth: {e.server.auth}</span>
            {(e.server.docsUrl ?? e.server.repoUrl) && <a class="fact" href={e.server.docsUrl ?? e.server.repoUrl} rel="noopener">{e.server.docsUrl ? 'docs' : 'repo'} ↗</a>}
          </div>
        )}
        {e.kind === 'skills' && e.skill.sourceUrl && <a class="fact" href={e.skill.sourceUrl} rel="noopener">source ↗</a>}
        {e.kind === 'plugins' && <a class="fact" href={e.plugin.repoUrl} rel="noopener">{e.plugin.marketplace} ↗</a>}
      </div>

      {e.kind === 'prompts' && <PromptBlock prompt={e.prompt} filename={`${e.slug}.prompt.md`} />}

      {e.kind !== 'prompts' && <InstallBlock options={installs} />}

      {e.kind === 'skills' && e.skill.skillMd && (
        <div class="sub-block">
          <h3 class="sub-title">The SKILL.md <span class="muted">· written for this site, MIT</span></h3>
          <div class="terminal">
            <div class="term-bar">
              <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>{e.skill.name}/SKILL.md</span>
              <button class="btn btn-sm copy-code" type="button" data-copy-code><span class="idle">⧉ Copy</span><span class="ok">✓ Copied</span></button>
            </div>
            <pre tabindex="0"><code data-code>{e.skill.skillMd}</code></pre>
          </div>
        </div>
      )}

      {e.kind === 'mcp' && e.tools.length > 0 && (
        <div class="sub-block">
          <h3 class="sub-title">Tools it exposes</h3>
          <ul class="tool-list">{e.tools.map((t) => <li><code>{t}</code></li>)}</ul>
        </div>
      )}

      {e.kind === 'plugins' && (
        <div class="sub-block">
          <h3 class="sub-title">What’s inside</h3>
          <ul class="tool-list">{e.plugin.includes.map((t) => <li>{t}</li>)}</ul>
        </div>
      )}
    </section>

    <section aria-labelledby="lose-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">no free lunch</span>
          <h2 id="lose-title">{loseTitle}</h2>
        </div>
      </div>
      <ul class="lose-list">
        {e.whatYouLose.map((item, i) => <li class="reveal" style={`--d:${i * 60}ms`}>{item}</li>)}
      </ul>
      <p class="notes reveal" style="margin-top:24px">{e.notes}</p>
    </section>

    {e.priorArt.length > 0 && (
      <section aria-labelledby="prior-title">
        <div class="section-head">
          <div>
            <span class="eyebrow">see also</span>
            <h2 id="prior-title">Prior art</h2>
          </div>
          <p class="muted" style="margin:0;font-size:13px">Open-source projects that already did the hard part.</p>
        </div>
        <ul class="prior">
          {e.priorArt.map((p, i) => (
            <li class="reveal" style={`--d:${i * 60}ms`}>
              <a href={p.url} rel="noopener">
                <span>{p.name}<small>{p.url.replace(/^https?:\/\//, '')}</small></span>
                <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {related.length > 0 && (
      <section aria-labelledby="related-title">
        <div class="section-head">
          <div>
            <span class="eyebrow">more {k.plural.toLowerCase()}</span>
            <h2 id="related-title">Related</h2>
          </div>
        </div>
        <div class="cards">
          {related.map((r, i) => (
            <a class="card reveal" href={entryPath(r)} style={`--d:${i * 70}ms`}>
              <div class="card-head">
                <img src={`/api/favicon/${r.slug}`} width="32" height="32" alt="" loading="lazy" />
                <span class={`badge ${r.verdict}`}>{verdictLabel(r)}</span>
              </div>
              <h3>{entryTitle(r)}</h3>
              <p>{CATEGORIES[r.category].emoji} {CATEGORIES[r.category].label}{r.priceMonthly !== null && ` · ${formatPrice(r.priceMonthly)}/mo`} · <span data-count-key={keyOf(r)}>0</span> {k.voted}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="faq-title">
      <div class="section-head">
        <div>
          <span class="eyebrow">faq</span>
          <h2 id="faq-title">{e.name}, answered</h2>
        </div>
      </div>
      <div class="faq">
        {faq.map((f, i) => (
          <details class="reveal" open={i === 0} style={`--d:${i * 50}ms`}>
            <summary>{f.q}</summary>
            <div class="answer"><p style="margin:0">{f.a}</p></div>
          </details>
        ))}
      </div>
    </section>

    <Waitlist source={`${e.kind}/${e.slug}`} />
  </div>
</Base>

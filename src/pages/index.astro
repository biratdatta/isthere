---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Ticker from '../components/Ticker.astro';
import EntryList from '../components/EntryList.astro';
import SearchBox from '../components/SearchBox.astro';
import Chips from '../components/Chips.astro';
import Odometer from '../components/Odometer.astro';
import LiveGlobe from '../components/LiveGlobe.astro';
import CategoryTile from '../components/CategoryTile.astro';
import { ENTRIES, apps, byKind, categoryStats } from '../lib/apps';
import { KINDS, KIND_ORDER } from '../lib/kinds';
import { SITE_TAGLINE, directoryItems, itemList } from '../lib/seo';

const chips = KIND_ORDER.map((k) => ({ key: k, label: KINDS[k].plural, count: byKind(k).length, kind: k }));
const rotate = ['skills', 'plugins', 'mcp', 'prompts', 'agents'] as const;
const title = 'Is there a skill for it? Skills, MCPs, plugins, prompts and agents that replace SaaS';
const description = `${ENTRIES.length} paid SaaS apps checked across five directories: is there a skill, an MCP server, a plugin, a one-shot prompt or an AI agent that replaces it? Honest verdicts and copy-paste installs for Claude Code, Codex and Cursor.`;
const site = Astro.site!;
---
<Base title={title} description={description} path="/" home jsonld={[itemList(site, 'Directories', directoryItems())]}>
  <section class="hero">
    <h1>
      <span class="sr-only">Is there a skill for it?</span>
      <span aria-hidden="true">Is there <span data-article>a</span> <a class="rot" href="/skills" data-rotate={rotate.map((k) => KINDS[k].word).join(',')} data-hrefs={rotate.map((k) => `/${k}`).join(',')}><span class="rot-word">skill</span></a> for it?</span>
    </h1>
    <div class="hero-side">
      <p class="lede">{SITE_TAGLINE} Honest verdicts, copy-paste installs, and what you actually give up.</p>
      <SearchBox action="/" placeholder={`Search ${ENTRIES.length} apps: notion, pdf, code review…`} />
    </div>
  </section>

  <section class="live-bar" aria-label="Live stats">
    <div class="live-cell"><b>{apps().length}</b><span>apps checked</span></div>
    <div class="live-cell"><b>$<span data-live="mrr"><Odometer value={0} label="0 dollars MRR destroyed" /></span></b><span>MRR destroyed / mo</span></div>
    <div class="live-cell"><b data-live="votesToday"><Odometer value={0} label="0 votes today" /></b><span>replaced today</span></div>
    <div class="live-cell"><b data-live="visitsToday"><Odometer value={0} label="0 visits today" /></b><span>visits today</span></div>
    <div class="live-cell now"><b><i class="live-dot" aria-hidden="true"></i><span data-live="online"><Odometer value={1} label="1 online" /></span></b><span>online right now</span></div>
  </section>

  <section aria-label="Directories" class="dir-grid">
    {KIND_ORDER.map((k, i) => (
      <a href={`/${k}`} class={`tile dir-tile k-${k} reveal`} style={`--d:${i * 70}ms`}>
        <span class="top"><span class="ico-badge"><Icon name={k} size={26} /></span>{byKind(k).length} apps</span>
        <span>
          <strong>Is there {KINDS[k].article} {KINDS[k].word} for it?</strong>
          <p>{KINDS[k].tagline}</p>
        </span>
      </a>
    ))}
  </section>

  <section id="list" class="board">
    <div class="board-side">
      <Ticker scope="all" metric="mrr" />
      <LiveGlobe />
    </div>
    <div class="card list-card reveal" style="min-width: 0">
      <div class="list-head">
        <h2>Cancel Culture</h2>
        <span class="muted mono" style="font-size:12px" data-result-count aria-live="polite">Top 20 of {ENTRIES.length}</span>
      </div>
      <div style="padding: 0 10px 12px">
        <Chips param="kind" chips={chips} total={ENTRIES.length} action="/" />
      </div>
      <EntryList entries={ENTRIES} filterBy="kind" limit={20} />
      <a class="see-all" href="/cancel-culture" data-see-all><span data-see-all-label>See the full list · all {ENTRIES.length}</span><Icon name="arrow" size={15} /></a>
    </div>
  </section>

  <section class="stack reveal" aria-labelledby="cats-title" style="gap:16px">
    <div class="list-head" style="padding:0">
      <h2 id="cats-title" class="section-title">Browse by category</h2>
      <a class="more-link" href="/categories">All {categoryStats().length} categories <Icon name="arrow" size={14} /></a>
    </div>
    <div class="cat-row">
      {categoryStats().slice(0, 10).map((c) => <CategoryTile c={c} compact />)}
    </div>
  </section>

  <section class="band dashed reveal" aria-labelledby="add-title">
    <div>
      <h2 id="add-title">Add your own is-there.</h2>
      <p>Five directories, open to everyone. Reviewed before it goes live.</p>
      <a href="/submit" class="btn btn-primary btn-lg" style="margin-top:20px">Submit one <Icon name="arrow" size={16} /></a>
    </div>
    <div class="pick4">
      {KIND_ORDER.map((k) => (
        <a href={`/submit?dir=${k}`} class={`tile k-${k}`}><Icon name={k} size={22} />{KINDS[k].plural}</a>
      ))}
    </div>
  </section>

  <section class="card ad-band reveal">
    <span style="display:flex;flex-direction:column;gap:6px">
      <strong>Advertise in the margins</strong>
      <span class="muted" style="font-size:14px">Four rail tiles beside every page and the Sponsor of the week card, booked by the week.</span>
    </span>
    <a href="/advertise" class="btn">Book a slot <Icon name="arrow" size={14} /></a>
  </section>
</Base>

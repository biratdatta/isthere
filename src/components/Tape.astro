---
import { formatPrice, keyOf, tickerSymbol, type Entry } from '../lib/apps';
import { KINDS } from '../lib/kinds';
import { entryPath } from '../lib/seo';

interface Props {
  entries: Entry[];
  /** Append the directory code (·MCP, ·SKL…) to each symbol, for mixed tapes. */
  showKind?: boolean;
}
const { entries, showKind = false } = Astro.props;
// Live counts arrive from /api/counts (see main.ts); order by price until then.
const items = [...entries].sort((a, b) => (b.priceMonthly ?? 0) - (a.priceMonthly ?? 0));
const dur = Math.max(40, items.length * 3.2);
---
<div class="tape" aria-label="Live board of tracked SaaS apps" style={`--tape-dur:${dur}s`}>
  <div class="tape-track">
    {[0, 1].map((copy) =>
      items.map((e) => (
        <a class="tape-item" href={entryPath(e)} tabindex={copy ? -1 : undefined} aria-hidden={copy ? 'true' : undefined} title={`${e.name} (${KINDS[e.kind].plural})`}>
          <span class="sym">{tickerSymbol(e)}{showKind && <span class="kd">·{KINDS[e.kind].short}</span>}</span>
          <span class="px">{e.priceMonthly === null ? 'USAGE' : formatPrice(e.priceMonthly)}</span>
          <span class="dn flat" data-tape-key={keyOf(e)} data-arrow={KINDS[e.kind].metric === 'users' ? '▲' : '▼'}>— 0</span>
        </a>
      ))
    )}
  </div>
</div>

---
/** Weekly email signup. Posts to /api/waitlist (stored in D1; no third-party mail service yet). */
import Icon from './Icon.astro';
interface Props { source?: string }
const { source = '' } = Astro.props;
---
<section class="newsletter" id="newsletter" aria-labelledby="nl-title">
  <span class="ico-badge sm"><Icon name="mail" size={20} /></span>
  <h2 id="nl-title">Every week, more subscriptions die.</h2>
  <p class="muted">New verdicts, price hikes, and the week’s most-replaced apps. One email on Thursdays. Unsubscribe in one click.</p>
  <form method="post" action="/api/waitlist" data-ajax-form="newsletter" class="nl-form">
    <input type="hidden" name="source" value={source || 'newsletter'} />
    <label class="sr-only" for="nl-email">Email</label>
    <input id="nl-email" name="email" type="email" required maxlength="254" placeholder="you@wherever.com" autocomplete="email" />
    <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
    <button type="submit" class="btn btn-primary"><span class="idle">Get Thursday’s email</span><span class="ok">You’re in</span></button>
    <p class="form-msg" role="status" aria-live="polite" data-form-msg></p>
  </form>
  <p class="fine-print">Free. The verdicts stay on the site; the email is just the week’s changes. <a href="/feed.xml">Prefer RSS?</a></p>
</section>

---
/**
 * Site footer: live stats strip, grouped links, weekly email, sponsor of the week and a giant wordmark.
 * Live numbers come from /api/pulse (see src/scripts/main.ts → "footer pulse").
 */
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { ENTRIES, addedOn, apps, keyOf } from '../lib/apps';
import { KINDS } from '../lib/kinds';
import { REPO_URL, entryPath } from '../lib/seo';
import { repoStars } from '../lib/github';

const stars = await repoStars;
const appCount = apps().length;
const lastAdded = ENTRIES.map(addedOn).sort().at(-1)!;
const names = Object.fromEntries(ENTRIES.map((e) => [keyOf(e), { n: e.name, u: entryPath(e), w: KINDS[e.kind].word }]));
---
<footer class="site-footer" data-footer>
  <a href="/advertise?slot=footer" class="sponsor-card">
    <span class="sponsor-logo" aria-hidden="true"><Icon name="megaphone" size={22} /></span>
    <span class="sponsor-text">
      <span class="eyebrow">Sponsor of the week</span>
      <strong>Your product here</strong>
      <span class="muted">One logo, one line, one link, on every page. No tracking pixels.</span>
    </span>
    <span class="sponsor-cta">Book this week <Icon name="arrow" size={14} /></span>
  </a>

  <section class="pulse" aria-label="Live numbers">
    <div class="pulse-stat"><b data-pulse="mrr">$0</b><span>MRR destroyed / mo</span></div>
    <div class="pulse-stat"><b data-pulse="votes">0</b><span>apps replaced</span></div>
    <div class="pulse-stat"><b>{appCount}</b><span>apps checked</span></div>
    <a class="pulse-stat hot" href="/stats" data-pulse-hot><b>—</b><span>hot this week</span></a>
  </section>


  <div class="foot-grid">
    <nav class="foot-col" aria-label="Directories">
      <span class="eyebrow">Directories</span>
      {(['skills', 'mcp', 'plugins', 'prompts', 'agents'] as const).map((k) => <a href={`/${k}`} class={`k-${k}`}><Icon name={k} size={14} class="ico-k" />{KINDS[k].plural}</a>)}
    </nav>
    <nav class="foot-col" aria-label="Explore">
      <span class="eyebrow">Explore</span>
      <a href="/cancel-culture">Cancel Culture</a>
      <a href="/stack">My stack</a>
      <a href="/alternatives">Free alternatives</a>
      <a href="/stats">Stats</a>
      <a href="/new">What’s new</a>
    </nav>
    <nav class="foot-col" aria-label="Community">
      <span class="eyebrow">Community</span>
      <a href="/submit">Submit</a>
      <a href="/requests">Request an app</a>
      <a href="/queue">Review queue</a>
      <a href="/contributors">Contributors</a>
      <a href="/advertise">Advertise</a>
    </nav>
    <div class="foot-col foot-news" id="newsletter">
      <span class="eyebrow">Weekly email</span>
      <span class="muted">New verdicts, price hikes, the week’s most-replaced. Thursdays.</span>
      <form method="post" action="/api/waitlist" data-ajax-form="newsletter" class="mini-news">
        <input type="hidden" name="source" value="footer" />
        <label class="sr-only" for="foot-email">Email</label>
        <input id="foot-email" name="email" type="email" required maxlength="254" placeholder="you@wherever.com" autocomplete="email" />
        <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit" class="btn btn-primary btn-sm"><span class="idle">Subscribe</span><span class="ok">You’re in</span></button>
        <p class="form-msg" role="status" aria-live="polite" data-form-msg></p>
      </form>
    </div>
  </div>

  <div class="wordmark-xl" aria-hidden="true"><Mark size={120} class="xl-mark" />is<span>there</span>?</div>

  <div class="foot-base">
    <span>
      MIT · no accounts · built by <a href="https://github.com/biratdatta" rel="noopener">@biratdatta</a> ·
      <a href={REPO_URL} rel="noopener" class="stars"><Icon name="github" size={13} />{stars !== null ? `${stars.toLocaleString('en-US')} ★` : 'Star on GitHub'}</a>
    </span>
    <span>Last verdict added <time datetime={lastAdded} data-ago>{lastAdded}</time></span>
  </div>
  <p class="fine">Prices are entry paid tiers, approximate and subject to change; verdicts are opinions. Install commands follow each tool’s docs; check before running anything.</p>
  <script is:inline type="application/json" id="footer-data" set:html={JSON.stringify({ names })} />
</footer>
<div class="toast" role="status" aria-live="polite" data-toast></div>

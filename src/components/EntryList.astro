---
/**
 * The ranked list as compact rows (home page). Prerendered in a default order;
 * main.ts fetches live counts, re-ranks the rows, and filters as you type.
 */
import Icon from './Icon.astro';
import { formatPrice, keyOf, searchText, verdictLabel, type Entry } from '../lib/apps';
import { KINDS } from '../lib/kinds';
import { entryPath } from '../lib/seo';

interface Props {
  entries: Entry[];
  filterBy: 'category' | 'kind';
  /** Show only the top N rows (after live re-ranking and filtering). */
  limit?: number;
}
const { entries, filterBy, limit } = Astro.props;
const rank = { yes: 0, kinda: 1, no: 2 } as const;
const ranked = [...entries].sort((a, b) => rank[a.verdict] - rank[b.verdict] || (b.priceMonthly ?? 0) - (a.priceMonthly ?? 0) || a.name.localeCompare(b.name));
const facet = (e: Entry) => (filterBy === 'kind' ? e.kind : e.category);
---
<ol class="rows" data-list data-limit={limit}>
  {ranked.map((e, i) => (
    <li data-search={searchText(e)} data-cat={facet(e)} data-key={keyOf(e)} data-order={i}>
      <a class={`row k-${e.kind} v-${e.verdict}`} href={entryPath(e)}>
        <span class="rank">{String(i + 1).padStart(2, '0')}</span>
        <span class="letter sm"><img src={`/api/favicon/${e.slug}`} width="20" height="20" alt="" loading={i < 10 ? 'eager' : 'lazy'} decoding="async" /></span>
        <span class="who">
          <strong>{e.name}</strong>
          <span><Icon name={e.kind} size={13} class="ico-k" />{KINDS[e.kind].plural} · {e.priceMonthly === null ? 'usage-based' : `${formatPrice(e.priceMonthly)}/mo`}</span>
        </span>
        <span class="badge">{verdictLabel(e)}</span>
        <span class="votes" data-count-key={keyOf(e)}>0</span>
      </a>
    </li>
  ))}
</ol>
<div class="empty" data-empty>Nothing matches <code data-empty-q></code> yet. <a href="/submit" style="color:var(--primary)">Add it →</a></div>

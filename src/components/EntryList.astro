---
/**
 * The ranked list (Death List / Most plugged-in). Server-filtered by ?q and ?cat
 * (or ?kind on the home page); main.ts re-filters live as you type.
 */
import { CATEGORIES, formatPrice, keyOf, searchText, verdictLabel, type Entry } from '../lib/apps';
import { KINDS } from '../lib/kinds';
import { entryPath } from '../lib/seo';

interface Props {
  entries: Entry[];
  counts: Map<string, number>;
  q: string;
  /** Value of the active chip; matched against data-cat. */
  filter: string;
  /** What chips filter on: category (directory pages) or kind (home page). */
  filterBy: 'category' | 'kind';
  showKind?: boolean;
}
const { entries, counts, q, filter, filterBy, showKind = false } = Astro.props;
const ranked = [...entries].sort(
  (a, b) => (counts.get(keyOf(b)) ?? 0) - (counts.get(keyOf(a)) ?? 0) || (b.priceMonthly ?? 0) - (a.priceMonthly ?? 0) || a.name.localeCompare(b.name)
);
const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
const facet = (e: Entry) => (filterBy === 'kind' ? e.kind : e.category);
const matches = (e: Entry) => (!filter || facet(e) === filter) && terms.every((t) => searchText(e).includes(t));
const visible = ranked.filter(matches).length;
---
<div class="section-head">
  <slot name="head" />
  <p class="muted" style="margin:0;font-size:13px" data-result-count aria-live="polite">{visible} of {ranked.length}</p>
</div>
<ol class="death-list" data-list>
  {ranked.map((e, i) => {
    const c = CATEGORIES[e.category];
    const k = KINDS[e.kind];
    const n = counts.get(keyOf(e)) ?? 0;
    return (
      <li class={`reveal ${matches(e) ? '' : 'row-hidden'}`} data-search={searchText(e)} data-cat={facet(e)} style={`--d:${Math.min(i, 10) * 40}ms`}>
        <a class="row" href={entryPath(e)}>
          <span class="rank">{String(i + 1).padStart(2, '0')}</span>
          <img class="fav" src={`/api/favicon/${e.slug}`} width="28" height="28" alt="" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
          <span class="name">{e.name}<small>{showKind ? `${k.emoji} ${k.word} · ${e.domain}` : e.domain}</small></span>
          <span class="cat" data-price={e.priceMonthly === null ? 'usage-based' : `${formatPrice(e.priceMonthly)}/mo`}>{c.emoji} {c.label}</span>
          <span class="price">{e.priceMonthly === null ? <small>usage</small> : <>{formatPrice(e.priceMonthly)}<small>/mo</small></>}</span>
          <span class={`badge ${e.verdict}`}>{verdictLabel(e)}</span>
          <span class="votes"><b>{n.toLocaleString('en-US')}</b><span class="vl"> {k.voted}</span></span>
        </a>
      </li>
    );
  })}
</ol>
<div class={`empty ${visible === 0 ? 'show' : ''}`} data-empty>
  <p>Nothing matches <code data-empty-q>{q || filter}</code> yet.</p>
  <p style="margin:0">Add it: open a PR with a JSON file in <code>data/&lt;directory&gt;/</code>.</p>
</div>

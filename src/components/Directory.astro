---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import Ticker from './Ticker.astro';
import EntryCards from './EntryCards.astro';
import SearchBox from './SearchBox.astro';
import Chips from './Chips.astro';
import { byKind, categoryCounts } from '../lib/apps';
import { KINDS, KIND_ORDER, type Kind } from '../lib/kinds';
import { breadcrumbs, entryPath, entryTitle, itemList } from '../lib/seo';

interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const k = KINDS[kind];
const entries = byKind(kind);
const byVerdict = { yes: 0, kinda: 0, no: 0 };
for (const e of entries) byVerdict[e.verdict]++;
const site = Astro.site!;
const title = `Is there ${k.article} ${k.word} for it? ${entries.length} SaaS apps, honest verdicts`;
const description = `${k.lede} ${entries.length} apps checked: ${byVerdict.yes} ${k.verdicts.yes.label}, ${byVerdict.kinda} ${k.verdicts.kinda.label}, ${byVerdict.no} ${k.verdicts.no.label}.`;
const others = KIND_ORDER.filter((x) => x !== kind);
const cats = categoryCounts(entries).map((c) => ({ key: c.key, label: c.label, count: c.count }));
---
<Base
  title={title}
  description={description}
  path={`/${kind}`}
  ogImage={`/og/${kind}.png`}
  kind={kind}
  jsonld={[
    breadcrumbs(site, [{ name: 'Home', path: '/' }, { name: k.plural, path: `/${kind}` }]),
    itemList(site, `${k.listTitle}: ${k.plural}`, entries.map((e) => ({ name: entryTitle(e), path: entryPath(e) }))),
  ]}
>
  <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">{k.plural}</li></ol></nav>

  <section class={`hero k-${kind}`}>
    <div class="page-title">
      <span class="ico-badge" style="width:60px;height:60px;border-radius:16px;background:color-mix(in srgb, var(--k) var(--tint), var(--surface))"><Icon name={kind} size={30} /></span>
      <h1>Is there {k.article} <span class="hl">{k.word}</span> for it?</h1>
      <p class="lede muted" style="font-size:18px;max-width:560px">{k.lede}</p>
    </div>
    <div class="stats">
      <div class="card stat"><b>{entries.length}</b><span>apps checked</span></div>
      <div class="tile stat k-mcp" style="--k:var(--green)"><b>{byVerdict.yes}</b><span>{k.verdicts.yes.label.toLowerCase()}</span></div>
      <div class="tile stat" style="--k:var(--amber)"><b>{byVerdict.kinda + byVerdict.no}</b><span>{k.verdicts.kinda.label.toLowerCase()} or {k.verdicts.no.label.toLowerCase()}</span></div>
    </div>
  </section>

  <section id="list" class="stack" style="gap:20px">
    <div class="toolbar">
      <SearchBox action={`/${kind}`} placeholder={`Search ${k.plural}…`} label={`Search ${k.plural}`} />
      <Chips param="cat" chips={cats} total={entries.length} action={`/${kind}`} kind={kind} />
    </div>
    <div class="list-head" style="padding:0">
      <span class="eyebrow">{k.listEyebrow}</span>
      <span class="muted mono" style="font-size:12px" data-result-count aria-live="polite">{entries.length} of {entries.length}</span>
    </div>
    <EntryCards entries={entries} />
  </section>

  <section class="grid-auto" style="--min:300px;align-items:start">
    <Ticker scope={kind} metric={k.metric} />
    {others.map((o) => (
      <a href={`/${o}`} class={`tile dir-link k-${o}`}>
        <span class="ico-badge sm"><Icon name={o} size={22} /></span>
        <span style="display:flex;flex-direction:column;gap:2px"><strong>Is there {KINDS[o].article} {KINDS[o].word} for it?</strong><span class="muted" style="font-size:13px">{byKind(o).length} apps</span></span>
        <Icon name="arrow" size={18} class="go" />
      </a>
    ))}
  </section>
</Base>

---
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import { KINDS, KIND_ORDER, type Kind } from '../lib/kinds';
import { byKind } from '../lib/apps';

interface Props {
  kind?: Kind;
  current?: 'list' | 'submit' | 'advertise';
}
const { kind, current } = Astro.props;
---
<header class="site-header">
  <nav class="pill-nav" aria-label="Main">
    <a href="/" class="wordmark" data-kind={kind} aria-label="isthere, home"><Mark />is<b>there</b>?</a>
    <div class="nav-links">
      <button type="button" aria-expanded="false" aria-controls="mega" data-mega-toggle aria-current={kind ? 'page' : undefined}>
        Directories <Icon name="chev" size={14} class="chev" />
      </button>
      <a href="/#list" aria-current={current === 'list' ? 'page' : undefined}>Death List</a>
      <a href="/submit" aria-current={current === 'submit' ? 'page' : undefined}>Submit</a>
      <a href="/advertise" aria-current={current === 'advertise' ? 'page' : undefined}>Advertise</a>
    </div>
    <div class="nav-actions">
      <a class="icon-btn nav-search" href="/#q" aria-label="Search" data-search-jump><Icon name="search" size={18} /></a>
      <a class="icon-btn stack-link" href="/stack" aria-label="My stack" title="My stack"><Icon name="layers" size={18} /><span class="stack-dot" data-stack-badge hidden></span></a>
      <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle theme (t)">
        <Icon name="moon" size={18} class="moon" /><Icon name="sun" size={18} class="sun" />
      </button>
      <button type="button" class="icon-btn mobile-dirs" data-mega-toggle aria-label="Directories" aria-expanded="false" aria-controls="mega" style="display:none"><Icon name="chev" size={18} /></button>
      <a href="/submit" class="btn btn-ink"><Icon name="plus" size={16} /><span class="add-label">Add yours</span></a>
    </div>
  </nav>

  <div class="mega" id="mega" data-mega>
    <div class="mega-grid">
      {KIND_ORDER.map((k) => (
        <a href={`/${k}`} class={`mega-tile k-${k}`} aria-current={kind === k ? 'page' : undefined}>
          <Icon name={k} size={24} class="ico-k" />
          <strong>{KINDS[k].plural}</strong>
          <span class="d">{KINDS[k].tagline}</span>
          <span class="mono muted" style="font-size:12px">{byKind(k).length} apps</span>
        </a>
      ))}
    </div>
    <div class="mega-side">
      <div style="display:flex;flex-direction:column;gap:10px">
        <span class="eyebrow">Community</span>
        <strong>Add your own is-there</strong>
        <span class="muted" style="font-size:14px;line-height:1.5">Submit a skill, MCP, plugin, prompt or agent that replaces a paid app. Reviewed before it goes live.</span>
      </div>
      <a href="/submit" class="btn btn-primary" style="align-self:flex-start">Submit one <Icon name="arrow" size={14} /></a>
      <nav class="mega-links" aria-label="Explore">
        <a href="/stack"><Icon name="layers" size={16} />My stack</a>
        <a href="/new"><Icon name="rss" size={16} />What’s new</a>
        <a href="/stats"><Icon name="chart" size={16} />Stats</a>
        <a href="/alternatives"><Icon name="external" size={16} />Free alternatives</a>
        <a href="/requests"><Icon name="megaphone" size={16} />Request an app</a>
        <a href="/contributors"><Icon name="github" size={16} />Contributors</a>
      </nav>
    </div>
  </div>
</header>
<style>
  @media (max-width: 860px) { .mobile-dirs { display: inline-grid !important; } }
</style>

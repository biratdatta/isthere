---
import { KINDS, KIND_ORDER, type Kind } from '../lib/kinds';

interface Props {
  kind?: Kind;
}
const { kind } = Astro.props;
// The logo settles on the current directory's word; start the cycle from it.
const start = kind ? KIND_ORDER.indexOf(kind) : 0;
const order = [...KIND_ORDER.slice(start), ...KIND_ORDER.slice(0, start)].map((k) => KINDS[k]);
const first = order[0];
---
<header class="site-header">
  <div class="wrap">
    <a href="/" class="logo" aria-label={`Is there ${first.article} ${first.word} for it? Home`}>
      <span class="caret">&gt;</span><span aria-hidden="true"><span class="full">is there <span data-logo-article>{first.article}</span> </span><span class="logo-word" data-logo-word={order.map((k) => k.word).join(',')}>{first.word}</span> for it?</span><span class="cursor" aria-hidden="true"></span>
    </a>
    <nav class="nav" aria-label="Directories">
      {KIND_ORDER.map((k) => (
        <a href={`/${k}`} aria-current={kind === k ? 'page' : undefined} class="nav-kind">
          <span aria-hidden="true">{KINDS[k].emoji}</span><span class="nav-label">{KINDS[k].plural}</span>
        </a>
      ))}
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle light/dark mode" title="Toggle theme (t)">
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div>
</header>

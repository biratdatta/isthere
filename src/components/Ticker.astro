---
import Odometer from './Odometer.astro';

interface Props {
  /** "all" or a directory id; picks which totals from /api/counts to show. */
  scope: string;
  /** "mrr" shows $X/mo destroyed; "users" shows a plain count. */
  metric: 'mrr' | 'users';
}
const { scope, metric } = Astro.props;
---
<div class="ticker reveal" data-ticker data-scope={scope} data-metric={metric}>
  <span class="label">{metric === 'mrr' ? 'COLLECTIVE MRR DESTROYED' : 'AGENTS PLUGGED IN'}</span>
  <span class="value">
    {metric === 'mrr' && <span aria-hidden="true">$</span>}
    <Odometer value={0} id={`ticker-${scope}`} label={metric === 'mrr' ? '$0 per month' : '0 agents'} />
    <span class="per">{metric === 'mrr' ? '/mo' : 'agents'}</span>
  </span>
  <span class="meta">
    {metric === 'mrr' ? (
      <>
        <span>▲ $<b data-total="mrr24h">0</b> today</span>
        <span><b data-total="votes">0</b> votes</span>
        <span>$<b data-total="mrr12">0</b> a year</span>
      </>
    ) : (
      <>
        <span>▲ <b data-total="votes24h">0</b> today</span>
        <span>Σ "I use this"</span>
      </>
    )}
  </span>
</div>

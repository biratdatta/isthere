{
  "name": "isthere",
  "version": "1.0.0",
  "private": true,
  "description": "Is there a skill, an MCP, a plugin or a prompt for it? A directory of what replaces the SaaS you pay for.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run og && astro dev",
    "og": "node scripts/og.mjs",
    "prebuild": "npm run og",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply isthere --local",
    "db:migrate:remote": "wrangler d1 migrations apply isthere --remote",
    "check-data": "node scripts/check-data.mjs",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.35.0",
    "wrangler": "^4.147.0"
  }
}

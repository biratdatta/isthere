# Public origin, used for canonical URLs, sitemap, JSON-LD and OG tags
SITE_URL=https://isthere.biratdatta.com

# Where the SQLite file lives (votes, waitlist, first-party analytics)
DB_PATH=./data/db/site.sqlite

# Set to 1 when running behind a reverse proxy so X-Forwarded-For is trusted
TRUST_PROXY=0

# Public repository link shown in the footer
REPO_URL=https://github.com/biratdatta/isthere

# Node adapter
HOST=0.0.0.0
PORT=4321
